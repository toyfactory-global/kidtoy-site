---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  return productsData.products.map(p => ({
    params: { handle: p.handle }
  }));
}

const { handle } = Astro.params;
const product = productsData.products.find(p => p.handle === handle);

if (!product) {
  return Astro.redirect('/404');
}

const mainImage = product.images?.[0]?.src || '/placeholder.jpg';
const detailImages = product.images?.slice(1) || [];
const productSku = product.variants?.[0]?.sku || `KT-${product.id.toString().slice(-8)}`;
const skuLabel = product.variants?.[0]?.sku ? 'Item No.' : 'Item No.';
const gallery = [{ src: mainImage, alt: product.title }, ...detailImages.map(img => ({ src: img.src, alt: img.alt || product.title }))];

/* ---- SEO helpers ------------------------------------------------------- */
const SITE = 'https://kidtoycn.com';
const stripHtml = (h) =>
  String(h || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&[a-z]+;/gi, ' ')
    .replace(/[\u2700-\u27bf\u{1f300}-\u{1faff}]/gu, '')
    .replace(/\s+/g, ' ')
    .trim();

const plainBody = stripHtml(product.body_html);
// Use the real body copy when it is substantive; otherwise fall back to a
// factual B2B sentence. Never emit the title alone (duplicate of `name`).
const metaDescription =
  plainBody.length >= 120 && !/^Global Shipping/i.test(plainBody)
    ? plainBody.slice(0, 300).replace(/\s+\S*$/, '') + '.'
    : `${product.title} — factory-direct wholesale from our Chenghai toy factory (est. 2001). MOQ ${product.moq} pcs, OEM/ODM and custom packaging available.`;

const catHandle = (product.collections || [])[0] || '';
const catTitle = productsData.collections.find((c) => c.handle === catHandle)?.title || 'All Products';

/* Internal linking: 4 same-category + 4 cross-category, always 8 targets.
   Before this the 40 product pages had ZERO links between them. */
const others = productsData.products.filter((p) => p.handle !== product.handle);
const inSameCat = others.filter((p) => catHandle && (p.collections || []).includes(catHandle));
const inOtherCat = others.filter((p) => !(catHandle && (p.collections || []).includes(catHandle)));
const relatedProducts = [...inSameCat.slice(0, 4), ...inOtherCat.slice(0, 8 - Math.min(4, inSameCat.length))];

/* Closing the loop: articles link to products, so products link back to the
   guides a buyer of this category actually needs. */
const GUIDE_MAP: Record<string, { slug: string; title: string }[]> = {
  'water-guns': [
    { slug: 'electric-water-gun-specs-that-matter', title: 'Electric water gun specs that matter' },
    { slug: 'shipping-bubble-toys-batteries-liquids', title: 'Shipping: batteries, liquids and freight' },
    { slug: 'hs-code-9503-toy-import-duty', title: 'How toy import duty is calculated' },
    { slug: 'container-loading-calculation-cartons-cbm', title: 'How many cartons fit in a container' },
  ],
  'bubble-toys': [
    { slug: 'wholesale-bubble-toys-buyers-guide', title: 'The bubble toy category, explained' },
    { slug: 'shipping-bubble-toys-batteries-liquids', title: 'Shipping: batteries, liquids and freight' },
    { slug: 'toy-moq-landed-cost-calculation', title: 'MOQ and landed cost, calculated' },
    { slug: 'container-loading-calculation-cartons-cbm', title: 'How many cartons fit in a container' },
  ],
  'stem-toys': [
    { slug: 'en71-vs-astm-f963-toy-certification', title: 'EN71 vs ASTM F963 vs CPSIA' },
    { slug: 'verify-toy-factory-chenghai-checklist', title: 'Verifying a toy factory before you pay' },
    { slug: 'toy-moq-landed-cost-calculation', title: 'MOQ and landed cost, calculated' },
  ],
  'kids-makeup': [
    { slug: 'wholesale-kids-beauty-sets-build-a-range', title: 'Building a kids beauty range' },
    { slug: 'kids-makeup-case-formats-buying-guide', title: 'How the case sets your retail price' },
    { slug: 'private-label-kids-makeup-moq-labelling', title: 'Private label: MOQ and label fields' },
  ],
};
const relatedGuides = GUIDE_MAP[catHandle] || [];

const priceValidUntil = new Date(Date.now() + 365 * 864e5).toISOString().slice(0, 10);
const absoluteImage = (src) => (src?.startsWith('http') ? src : SITE + src);
---

<BaseLayout title={product.title} description={product.title + ' - Factory direct wholesale pricing. MOQ 50+ pcs, OEM/ODM supported.'} ogImage={mainImage}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-orange">Home</a> / 
      <a href="/collections/all/" class="hover:text-orange">Products</a> / 
      <span class="text-navy font-semibold">{product.title}</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Images -->
      <div>
        <div class="relative">
          <div class="aspect-square bg-gray-50 rounded-2xl flex items-center justify-center overflow-hidden mb-4">
            <img id="main-product-image" src={mainImage} alt={product.title} class="w-full h-full object-contain p-6" />
          </div>
          {(() => {
            const allImages = [{ src: mainImage, alt: product.title }, ...detailImages];
            return (
              <div>
                <button aria-label="Previous image" onclick="prevImage()" class="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 shadow-md flex items-center justify-center text-navy text-xl hover:bg-white transition-colors z-10">&#8249;</button>
                <button aria-label="Next image" onclick="nextImage()" class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 shadow-md flex items-center justify-center text-navy text-xl hover:bg-white transition-colors z-10">&#8250;</button>
              </div>
            );
          })()}
        </div>
        {detailImages.length > 0 && (
          <div class="grid grid-cols-4 gap-3">
            {[{ src: mainImage, alt: product.title }, ...detailImages].map((img, i) => (
              <div class="aspect-square bg-gray-50 rounded-lg overflow-hidden cursor-pointer" onclick={`goToImage(${i})`}>
                <img src={img.src} alt={img.alt || product.title} class="w-full h-full object-contain p-2" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <div>
        <h1 class="text-lg sm:text-xl lg:text-2xl font-extrabold text-navy leading-snug mb-4 break-words">{product.title}</h1>

        <!-- Price Card: Tiered Pricing -->
        <div class="relative bg-white rounded-2xl shadow-md border border-gray-100 p-6 mb-6 overflow-hidden">
          <span class="absolute top-0 right-0 bg-orange text-white text-[11px] font-extrabold uppercase tracking-wider px-4 py-1.5" style="border-bottom-left-radius: 10px;">Tiered Pricing</span>
          <p class="text-sm font-semibold text-navy mb-4">{skuLabel}: <span class="text-gray-500 font-normal">{productSku}</span></p>
          <div class="space-y-2.5">
            <div class="flex items-center justify-between bg-gray-100 rounded-lg px-4 py-3.5">
              <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Standard MOQ ({product.moq || 'Bulk'}+)</span>
              <span class="text-2xl font-extrabold text-navy">{product.price > 0 ? `$${product.price.toFixed(2)}` : 'Price on Request'}<span class="text-sm font-bold text-gray-400">/Piece</span></span>
            </div>
            <div class="flex items-center justify-between bg-orange-50 border border-orange-200 rounded-lg px-4 py-3.5">
              <span class="text-sm font-extrabold text-gray-800 uppercase tracking-wide">Bulk Discount</span>
              <span class="text-sm font-extrabold text-orange uppercase tracking-wide">Contact for Discount</span>
            </div>
            <div class="flex items-center justify-between bg-blue-50 border border-blue-100 rounded-lg px-4 py-3.5">
              <span class="text-sm font-bold text-blue-400 uppercase tracking-wide">Container Load</span>
              <span class="text-sm font-extrabold text-navy uppercase tracking-wide">Best Price | Inquiry Now</span>
            </div>
          </div>
        </div>

        <!-- Key Selling Points -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">Tiered Pricing</p>
              <p class="text-xs text-gray-400">Better price for bulk</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">OEM/ODM</p>
              <p class="text-xs text-gray-400">Custom branding available</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">Certified Safety</p>
              <p class="text-xs text-gray-400">CE · ASTM · EN71</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">Global Shipping</p>
              <p class="text-xs text-gray-400">Sea · Air · Express</p>
            </div>
          </div>
        </div>

        <!-- Variants -->
        {product.variants.length > 1 && (
          <div class="mb-6">
            <h3 class="text-sm font-bold text-navy mb-2">Variants</h3>
            <div class="flex flex-wrap gap-2">
              {product.variants.map(v => (
                <span class="text-xs bg-white border border-gray-200 px-3 py-1.5 rounded-full text-navy font-semibold">
                  {v.title}: ${v.price.toFixed(2)}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
          <a href={`https://wa.me/8613715961913?text=Hello%2C%20I%20am%20interested%20in%20${encodeURIComponent(product.title)}%20(SKU:%20${encodeURIComponent(product.id)})`} target="_blank" rel="noopener noreferrer" class="flex-1 bg-green-500 text-white text-center px-6 py-4 rounded font-bold text-sm hover:bg-green-600 transition-colors">
            WhatsApp Inquiry
          </a>
          <a href="/contact/" target="_blank" rel="noopener noreferrer" class="flex-1 bg-navy text-white text-center px-6 py-4 rounded font-bold text-sm hover:bg-orange transition-colors">
            Request Quote
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="bg-navy text-white rounded-xl p-5 mb-8">
          <p class="text-sm font-extrabold text-center mb-3 tracking-wide">EXPERIENCED TOY MANUFACTURER SINCE 2001</p>
          <div class="flex justify-center gap-4 text-center">
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">25+</p>
              <p class="text-xs text-gray-300 mt-1">Years Export</p>
            </div>
            <div class="w-px bg-gray-600"></div>
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">ISO</p>
              <p class="text-xs text-gray-300 mt-1">22716/GMPC</p>
            </div>
            <div class="w-px bg-gray-600"></div>
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">BSCI</p>
              <p class="text-xs text-gray-300 mt-1">Certified</p>
            </div>
            <div class="w-px bg-gray-600"></div>
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">OEM</p>
              <p class="text-xs text-gray-300 mt-1">Custom OK</p>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="prose prose-sm max-w-none text-gray-500 leading-relaxed">
          <div set:html={product.body_html || ''} />
        </div>
      </div>
    </div>

    <!-- Product JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": `${SITE}/products/${product.handle}/#product`,
      "name": product.title,
      "url": `${SITE}/products/${product.handle}/`,
      "image": gallery.map((g) => absoluteImage(g.src)),
      "description": metaDescription,
      "sku": productSku,
      "mpn": productSku,
      "category": catTitle,
      "brand": { "@type": "Brand", "name": "Kidtoy Factory" },
      "manufacturer": { "@id": `${SITE}/#organization` },
      "itemCondition": "https://schema.org/NewCondition",
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Wholesale distributors, retailers and brand owners"
      },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Minimum Order Quantity", "value": `${product.moq} pcs` },
        { "@type": "PropertyValue", "name": "OEM/ODM", "value": "Available, including custom packaging" },
        { "@type": "PropertyValue", "name": "Place of Origin", "value": "Chenghai, Guangdong, China" },
        { "@type": "PropertyValue", "name": "Factory Established", "value": "2001" }
      ],
      "offers": {
        "@type": "Offer",
        "url": `${SITE}/products/${product.handle}/`,
        "priceCurrency": "USD",
        "price": product.price.toFixed(2),
        "priceValidUntil": priceValidUntil,
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@id": `${SITE}/#organization` }
      }
    })} />

    <!-- Breadcrumb JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kidtoycn.com/" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://kidtoycn.com/collections/all" },
        { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://kidtoycn.com/products/${product.handle}` }
      ]
    })} />

    <!-- Related buying guides (product -> article half of the internal link loop) -->
    {relatedGuides.length > 0 && (
      <section class="mt-16 pt-10 border-t border-gray-100">
        <h2 class="text-xl font-extrabold text-navy mb-5">Before You Order: Buyer Guides</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {relatedGuides.map((g) => (
            <a href={`/blog/${g.slug}/`} class="group block border border-gray-100 rounded-xl p-5 hover:border-orange hover:shadow-sm transition-all">
              <p class="text-xs font-bold uppercase tracking-widest text-orange mb-2">Guide</p>
              <p class="text-sm font-bold text-navy group-hover:text-orange transition-colors leading-snug">{g.title}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related products: internal-link matrix (was 0 links between product pages) -->
    {relatedProducts.length > 0 && (
      <section class="mt-20 pt-12 border-t border-gray-100">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy mb-2">Related Wholesale Products</h2>
        <p class="text-gray-400 mb-8">
          More items from our {catTitle} range and across the factory catalogue — same OEM/ODM terms, same quality control.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {relatedProducts.map((rp) => (
            <ProductCard
              title={rp.title}
              handle={rp.handle}
              price={rp.price}
              image={rp.images?.[0]?.src || '/placeholder.jpg'}
              imageAlt={rp.images?.[0]?.alt || rp.title}
            />
          ))}
        </div>
        <div class="text-center mt-10">
          <a
            href={catHandle ? `/collections/${catHandle}/` : '/collections/all/'}
            class="inline-block bg-navy text-white font-bold px-8 py-3 rounded-lg hover:bg-orange transition-colors"
          >
            View All {catTitle}
          </a>
        </div>
      </section>
    )}
  </article>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(gallery)}></script>
  <script is:inline>
    const galleryImages = JSON.parse(document.getElementById('gallery-data').textContent);
    let currentImage = 0;

    function renderMain() {
      const main = document.getElementById('main-product-image');
      main.src = galleryImages[currentImage].src;
      main.alt = galleryImages[currentImage].alt || main.alt;
    }
    function nextImage() {
      currentImage = (currentImage + 1) % galleryImages.length;
      renderMain();
    }
    function prevImage() {
      currentImage = (currentImage - 1 + galleryImages.length) % galleryImages.length;
      renderMain();
    }
    function goToImage(i) {
      currentImage = i;
      renderMain();
    }
  </script>
</BaseLayout>
