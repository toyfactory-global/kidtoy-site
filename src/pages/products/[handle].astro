---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductInquiryForm from '../../components/ProductInquiryForm.astro';
import productsData from '../../../data/products.json';
import { GUIDE_MAP } from '../../data/guide-map';

export function getStaticPaths() {
  return productsData.products.map(p => ({
    params: { handle: p.handle }
  }));
}

const { handle } = Astro.params;
const product = productsData.products.find(p => p.handle === handle);

if (!product) {
  return Astro.redirect('/404');
}

const mainImage = product.images?.[0]?.src || '/placeholder.jpg';
const detailImages = product.images?.slice(1) || [];
const productSku = product.variants?.[0]?.sku || `KT-${product.id.toString().slice(-8)}`;
const productUnit = product.unit || 'pcs';
const productUnitOne = productUnit.replace(/s$/, '');
const skuLabel = product.variants?.[0]?.sku ? 'Item No.' : 'Item No.';
const gallery = [{ src: mainImage, alt: product.title }, ...detailImages.map(img => ({ src: img.src, alt: img.alt || product.title }))];

// Optional demo clip, self-hosted under /videos/. Only this one item has one so
// far; everything else renders without the section.
const video = product.video || null;

// Landscape clips get a wide player, portrait ones stay narrow. A 16:9 video in a
// 420px column would be a 236px strip - too small to see what is being played.
const videoMaxWidth = !video ? 420 : video.width >= video.height ? 760 : 420;

/* ---- Certification, evidenced per product ------------------------------
 * The trust card used to read "Certified Safety / CE · ASTM · EN71" on every
 * product page regardless of what was on file. The ERP export leaves the 认证
 * field empty for most items, so that line asserted marks the factory may not
 * hold for the model — the first thing a buyer checks before a test order.
 *
 * Now the card quotes the product's own specification table, and falls back to
 * an invitation to ask rather than a claim.
 */
const certMatch = String(product.body_html || '').match(
  /<td[^>]*>\s*Certification\s*<\/td>\s*<td[^>]*>([\s\S]*?)<\/td>/i
);
const certRaw = certMatch
  ? certMatch[1].replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim()
  : '';
const certText = /^[-–—0]?$|^n\/?a$|^none$/i.test(certRaw) ? '' : certRaw;

/* ---- Key facts ----------------------------------------------------------
   Buyers and AI engines both want the same few numbers before anything else:
   MOQ, price, units per carton, carton size and CBM. All of it is already in
   the spec table — this only lifts it into named fields. Nothing is inferred:
   if a row is absent, the field is not rendered.
*/
const specRows = (() => {
  const specTable = (() => {
    const all = String(product.body_html || '').match(/<table[\s\S]*?<\/table>/gi) || [];
    return all.find((t) => /Item No\./i.test(t)) || all[0] || null;
  })();
  const table = specTable;
  if (!table) return {};
  const out = {};
  for (const tr of (table.match(/<tr[\s\S]*?<\/tr>/gi) || [])) {
    const cells = [...tr.matchAll(/<t[dh][^>]*>([\s\S]*?)<\/t[dh]>/gi)].map((m) =>
      m[1].replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim()
    );
    if (cells.length >= 2 && cells[0] && !(cells[0].toLowerCase() in out)) {
      out[cells[0].toLowerCase()] = cells[1];
    }
  }
  return out;
})();
const spec = (...aliases) => {
  for (const a of aliases) {
    const v = specRows[a.toLowerCase()];
    if (v && !/^[-–—]+$/.test(v)) return v;
  }
  return '';
};

const fCartonQty = spec('Export Carton Qty', 'Quantity Per Full Export Carton', 'Inner Box Qty');
const fCartonSize = spec('Carton Dimension', 'Carton Size', 'Outer Export Carton Size');
const fCartonCbm = spec('Carton Volume', 'Export Carton Volume', 'CBM');
const fCartonGw = spec('Carton Gross Weight', 'G.W./N.W.');
const fPieces = spec('Pieces', 'Pieces per set', 'Set Contents', 'Contents');
const fPack = spec('Packaging Size', 'Single Package Size', 'Package Type & Size', 'Packing', 'Unit size', 'Box size');

const keyFacts = [
  { k: 'Item No.', v: productSku },
  { k: 'MOQ', v: `${product.moq} ${productUnit}` },
  { k: 'FOB price', v: product.price > 0 ? `USD ${product.price.toFixed(2)} / ${productUnitOne} at MOQ` : 'Quoted on request' },
  fPieces ? { k: 'Set contents', v: fPieces } : null,
  fCartonQty ? { k: 'Units per carton', v: fCartonQty } : null,
  fCartonSize ? { k: 'Carton size', v: fCartonSize } : null,
  fCartonCbm ? { k: 'Carton volume', v: fCartonCbm } : null,
  fCartonGw ? { k: 'Carton gross weight', v: fCartonGw } : null,
  fPack ? { k: 'Inner packing', v: fPack } : null,
  { k: 'Testing scope', v: certText || 'Testing on request — ask us what applies' },
].filter(Boolean);

/* ---- SEO helpers ------------------------------------------------------- */
const SITE = 'https://kidtoycn.com';
const stripHtml = (h) =>
  String(h || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&[a-z]+;/gi, ' ')
    .replace(/[\u2700-\u27bf\u{1f300}-\u{1faff}]/gu, '')
    .replace(/\s+/g, ' ')
    .trim();

/* Body copy nearly always opens with section headings ("Full Product
   Specification Details", "Product Highlights"), and an earlier version sliced
   the meta description straight off that, producing 22 pages whose search
   snippet read "Full Product Specification Details Item Detailed Parameters
   Item No. S212709 ...". Several of those sat at position 5-8 with zero clicks
   in 92 days. Strip the lead-in headings before taking the first sentence. */
const SECTION_HEADING =
  /^(?:Full Product Specification Details|Product Specification Details|Product Highlights|Product Details|Product Features|Key Features|Main Features|Features|Specifications|Specification|Description)\s*[:：]?\s*/i;
const stripHeadings = (text) => {
  let out = text;
  for (let i = 0; i < 8; i += 1) {
    const next = out.replace(SECTION_HEADING, '');
    if (next === out) break;
    out = next;
  }
  // leftover check marks and box glyphs from pasted supplier copy
  return out.replace(/[\u2705\u274c\u2b50\u26a0\u2611\u25a0\u25cf\u2192\ufe0f]/g, '').replace(/\s+/g, ' ').trim();
};

const plainBody = stripHeadings(stripHtml(String(product.body_html || '').replace(/<table[\s\S]*?<\/table>/gi, ' ')));
// Use the real body copy when it is substantive; otherwise fall back to a
// factual B2B sentence. Never emit the title alone (duplicate of `name`).
const metaDescription =
  plainBody.length >= 120 && !/^Global Shipping/i.test(plainBody)
    ? plainBody.slice(0, 300).replace(/\s+\S*$/, '') + '.'
    : `${product.title} — factory-direct wholesale from our Chenghai toy factory (est. 2001). MOQ ${product.moq} ${productUnit}, OEM/ODM and custom packaging available.`;

// <meta name="description"> is capped near 155 chars and must always carry the
// REAL order quantity for this SKU. A hardcoded "MOQ 50+" used to be stamped on
// all 40 products, which was wrong for every item whose MOQ is higher.
const metaDescShort = (() => {
  /* Prefer a complete first sentence: a snippet cut mid-clause reads like a
     truncation, and a snippet ending in "…" loses clicks even at position 5. */
  const base = metaDescription.replace(/\s+/g, ' ').trim();
  const sentence = (base.match(/^(.{35,140}?[.!?])\s/) || [])[1] || '';
  if (sentence && sentence.length + ` MOQ ${product.moq} ${productUnit}.`.length <= 158) {
    return `${sentence} MOQ ${product.moq} ${productUnit}.`;
  }
  /* If the sentence is too long, end on a clause rather than mid-phrase: a
     comma becomes a full stop, so the snippet reads as a finished thought. */
  const cut = (() => {
    if (base.length <= 130) return base;
    const window = base.slice(0, 130);
    const clause = (window.match(/^([\s\S]*[,;:])\s/) || [])[1] || '';
    if (clause.length >= 80 && clause.length + ` MOQ ${product.moq} ${productUnit}.`.length <= 158) {
      return clause.replace(/[,;:]$/, '.');
    }
    return window.replace(/\s+\S*$/, '') + '…';
  })();
  return `${cut} MOQ ${product.moq} ${productUnit}.`;
})();

const catHandle = (product.collections || [])[0] || '';
const catTitle = productsData.collections.find((c) => c.handle === catHandle)?.title || 'All Products';

/* Internal linking: 4 same-category + 4 cross-category, always 8 targets.
   Before this the 40 product pages had ZERO links between them. */
const others = productsData.products.filter((p) => p.handle !== product.handle);
const inSameCat = others.filter((p) => catHandle && (p.collections || []).includes(catHandle));
const inOtherCat = others.filter((p) => !(catHandle && (p.collections || []).includes(catHandle)));
const relatedProducts = [...inSameCat.slice(0, 4), ...inOtherCat.slice(0, 8 - Math.min(4, inSameCat.length))];

/* Closing the loop: articles link to products, so products link back to the
   guides a buyer of this category actually needs. */
const relatedGuides = GUIDE_MAP[catHandle] || [];


const priceValidUntil = new Date(Date.now() + 365 * 864e5).toISOString().slice(0, 10);
const absoluteImage = (src) => (src?.startsWith('http') ? src : SITE + src);
---

<BaseLayout title={product.title} description={metaDescShort} ogImage={absoluteImage(mainImage)}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-orange">Home</a> / 
      <a href="/collections/all/" class="hover:text-orange">Products</a> / 
      <span class="text-navy font-semibold">{product.title}</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Images -->
      <div>
        <div class="relative">
          <div class="aspect-square bg-gray-50 rounded-2xl flex items-center justify-center overflow-hidden mb-4">
            <img id="main-product-image" src={mainImage} alt={product.title} class="w-full h-full object-contain p-6" />
          </div>
          {(() => {
            const allImages = [{ src: mainImage, alt: product.title }, ...detailImages];
            return (
              <div>
                <button aria-label="Previous image" onclick="prevImage()" class="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 shadow-md flex items-center justify-center text-navy text-xl hover:bg-white transition-colors z-10">&#8249;</button>
                <button aria-label="Next image" onclick="nextImage()" class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 shadow-md flex items-center justify-center text-navy text-xl hover:bg-white transition-colors z-10">&#8250;</button>
              </div>
            );
          })()}
        </div>
        {detailImages.length > 0 && (
          <div class="grid grid-cols-4 gap-3">
            {[{ src: mainImage, alt: product.title }, ...detailImages].map((img, i) => (
              <div class="aspect-square bg-gray-50 rounded-lg overflow-hidden cursor-pointer" onclick={`goToImage(${i})`}>
                <img src={img.src} alt={img.alt || product.title} class="w-full h-full object-contain p-2" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <div>
        <h1 class="text-lg sm:text-xl lg:text-2xl font-extrabold text-navy leading-snug mb-4 break-words">{product.title}</h1>

        <!-- Price Card: Tiered Pricing -->
        <div class="relative bg-white rounded-2xl shadow-md border border-gray-100 p-6 mb-6 overflow-hidden">
          <span class="absolute top-0 right-0 bg-orange text-white text-[11px] font-extrabold uppercase tracking-wider px-4 py-1.5" style="border-bottom-left-radius: 10px;">Tiered Pricing</span>
          <p class="text-sm font-semibold text-navy mb-4">{skuLabel}: <span class="text-gray-500 font-normal">{productSku}</span></p>
          <div class="space-y-2.5">
            <div class="flex items-center justify-between bg-gray-100 rounded-lg px-4 py-3.5">
              <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Standard MOQ ({product.moq || 'Bulk'}+)</span>
              <span class="text-2xl font-extrabold text-navy">{product.price > 0 ? `$${product.price.toFixed(2)}` : 'Price on Request'}<span class="text-sm font-bold text-gray-400">/Piece</span></span>
            </div>
            <div class="flex items-center justify-between bg-orange-50 border border-orange-200 rounded-lg px-4 py-3.5">
              <span class="text-sm font-extrabold text-gray-800 uppercase tracking-wide">Bulk Discount</span>
              <span class="text-sm font-extrabold text-orange uppercase tracking-wide">Contact for Discount</span>
            </div>
            <div class="flex items-center justify-between bg-blue-50 border border-blue-100 rounded-lg px-4 py-3.5">
              <span class="text-sm font-bold text-blue-400 uppercase tracking-wide">Container Load</span>
              <span class="text-sm font-extrabold text-navy uppercase tracking-wide">Best Price | Inquiry Now</span>
            </div>
          </div>
        </div>

        <!-- Key facts: the numbers a buyer checks before reading anything else,
             and the block AI answers quote when someone asks for a spec -->
        <section class="mb-6 rounded-2xl border border-gray-100 overflow-hidden">
          <h2 class="bg-navy text-white text-[11px] font-extrabold uppercase tracking-widest px-5 py-3">Key Facts</h2>
          <dl class="divide-y divide-gray-100 bg-white">
            {keyFacts.map((f) => (
              <div class="flex items-start justify-between gap-6 px-5 py-2.5">
                <dt class="text-[11px] font-bold uppercase tracking-wide text-gray-400 pt-0.5 shrink-0">{f.k}</dt>
                <dd class="text-sm font-semibold text-navy text-right leading-snug break-words">{f.v}</dd>
              </div>
            ))}
          </dl>
        </section>

        <!-- Key Selling Points -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">Tiered Pricing</p>
              <p class="text-xs text-gray-400">Better price for bulk</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">OEM/ODM</p>
              <p class="text-xs text-gray-400">Custom branding available</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">{certText ? 'Certified Safety' : 'Testing on Request'}</p>
              <p class="text-xs text-gray-400 line-clamp-2">{certText || 'Ask us what applies'}</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5 bg-gray-50 rounded-lg p-3.5">
            <span class="text-green-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <p class="text-sm font-bold text-navy leading-tight">Global Shipping</p>
              <p class="text-xs text-gray-400">Sea · Air · Express</p>
            </div>
          </div>
        </div>

        <!-- Variants -->
        {product.variants.length > 1 && (
          <div class="mb-6">
            <h3 class="text-sm font-bold text-navy mb-2">Variants</h3>
            <div class="flex flex-wrap gap-2">
              {product.variants.map(v => (
                <span class="text-xs bg-white border border-gray-200 px-3 py-1.5 rounded-full text-navy font-semibold">
                  {v.title}: ${v.price.toFixed(2)}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
          <a href={`https://wa.me/8613715961913?text=Hello%2C%20I%20am%20interested%20in%20${encodeURIComponent(product.title)}%20(Item%20No.%3A%20${encodeURIComponent(productSku)})`} target="_blank" rel="noopener noreferrer" class="flex-1 bg-green-500 text-white text-center px-6 py-4 rounded font-bold text-sm hover:bg-green-600 transition-colors">
            WhatsApp Inquiry
          </a>
          <a href="#inquiry" class="flex-1 bg-navy text-white text-center px-6 py-4 rounded font-bold text-sm hover:bg-orange transition-colors">
            Request Quote
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="bg-navy text-white rounded-xl p-5 mb-8">
          <p class="text-sm font-extrabold text-center mb-3 tracking-wide">EXPERIENCED TOY MANUFACTURER SINCE 2001</p>
          <div class="flex justify-center gap-4 text-center">
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">25+</p>
              <p class="text-xs text-gray-300 mt-1">Years Export</p>
            </div>
            <div class="w-px bg-gray-600"></div>
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">ISO</p>
              <p class="text-xs text-gray-300 mt-1">22716/GMPC</p>
            </div>
            <div class="w-px bg-gray-600"></div>
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">BSCI</p>
              <p class="text-xs text-gray-300 mt-1">Certified</p>
            </div>
            <div class="w-px bg-gray-600"></div>
            <div class="flex-1">
              <p class="text-orange font-extrabold text-lg leading-none">OEM</p>
              <p class="text-xs text-gray-300 mt-1">Custom OK</p>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="prose prose-sm max-w-none text-gray-500 leading-relaxed">
          <div set:html={product.body_html || ''} />
        </div>
      </div>
    </div>

    <!-- Product video. Self-hosted rather than embedded: the clip shows the item
         being played, which is the one thing a still photo cannot convey, and a
         YouTube dependency was not available for this listing. preload="none"
         keeps 4.6 MB off the initial page load; the poster carries the visual. -->
    {video && (
      <section class="mt-14 pt-10 border-t border-gray-100">
        <div class="max-w-3xl mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-orange mb-2">Demo</p>
          <h2 class="text-2xl font-extrabold text-navy">See it played</h2>
        </div>
        <div class="mx-auto" style={`max-width: ${videoMaxWidth}px;`}>
          <video
            class="w-full rounded-xl bg-navy shadow-sm"
            controls
            playsinline
            preload="none"
            poster={video.poster}
            width={video.width}
            height={video.height}
          >
            <source src={video.src} type="video/mp4" />
            Your browser does not support embedded video.
          </video>
          <p class="text-xs text-gray-400 mt-3 text-center">
            {video.caption || 'Product demo'} · {video.durationLabel || ''}
          </p>
        </div>
      </section>
    )}

    <ProductInquiryForm productTitle={product.title} sku={productSku} moq={product.moq} />

    <!-- Product JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": `${SITE}/products/${product.handle}/#product`,
      "name": product.title,
      "url": `${SITE}/products/${product.handle}/`,
      "image": gallery.map((g) => absoluteImage(g.src)),
      "description": metaDescription,
      "sku": productSku,
      "mpn": productSku,
      "category": catTitle,
      "brand": { "@type": "Brand", "name": "Kidtoy Factory" },
      "manufacturer": { "@id": `${SITE}/#organization` },
      "itemCondition": "https://schema.org/NewCondition",
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Wholesale distributors, retailers and brand owners"
      },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Minimum Order Quantity", "value": `${product.moq} ${productUnit}` },
        { "@type": "PropertyValue", "name": "OEM/ODM", "value": "Available, including custom packaging" },
        { "@type": "PropertyValue", "name": "Place of Origin", "value": "Chenghai, Guangdong, China" },
        { "@type": "PropertyValue", "name": "Factory Established", "value": "2001" },
        ...(fCartonQty ? [{ "@type": "PropertyValue", "name": "Units per carton", "value": fCartonQty }] : []),
        ...(fCartonSize ? [{ "@type": "PropertyValue", "name": "Carton size", "value": fCartonSize }] : []),
        ...(fCartonCbm ? [{ "@type": "PropertyValue", "name": "Carton volume", "value": fCartonCbm }] : []),
        ...(fCartonGw ? [{ "@type": "PropertyValue", "name": "Carton gross weight", "value": fCartonGw }] : []),
        ...(fPieces ? [{ "@type": "PropertyValue", "name": "Set contents", "value": fPieces }] : [])
      ],
      "offers": {
        "@type": "Offer",
        "url": `${SITE}/products/${product.handle}/`,
        "priceCurrency": "USD",
        "price": product.price.toFixed(2),
        "priceValidUntil": priceValidUntil,
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@id": `${SITE}/#organization` }
      }
    })} />

    <!-- VideoObject: the clip is self-hosted, so this is the only structured
         signal that tells a search engine a product video exists here. -->
    {video && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "VideoObject",
        "name": `${product.title} - product demo`,
        "description": `${product.title}. Wholesale from Kidtoy Factory, Chenghai.`,
        "thumbnailUrl": [absoluteImage(video.poster)],
        "uploadDate": video.uploadDate,
        "duration": video.duration,
        "contentUrl": absoluteImage(video.src),
        "embedUrl": `${SITE}/products/${product.handle}/`,
        "publisher": { "@id": `${SITE}/#organization` }
      })} />
    )}

    <!-- Breadcrumb JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kidtoycn.com/" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://kidtoycn.com/collections/all" },
        { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://kidtoycn.com/products/${product.handle}` }
      ]
    })} />

    <!-- Related buying guides (product -> article half of the internal link loop) -->
    {relatedGuides.length > 0 && (
      <section class="mt-16 pt-10 border-t border-gray-100">
        <h2 class="text-xl font-extrabold text-navy mb-5">Before You Order: Buyer Guides</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {relatedGuides.map((g) => (
            <a href={`/blog/${g.slug}/`} class="group block border border-gray-100 rounded-xl p-5 hover:border-orange hover:shadow-sm transition-all">
              <p class="text-xs font-bold uppercase tracking-widest text-orange mb-2">Guide</p>
              <p class="text-sm font-bold text-navy group-hover:text-orange transition-colors leading-snug">{g.title}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related products: internal-link matrix (was 0 links between product pages) -->
    {relatedProducts.length > 0 && (
      <section class="mt-20 pt-12 border-t border-gray-100">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy mb-2">Related Wholesale Products</h2>
        <p class="text-gray-400 mb-8">
          More items from our {catTitle} range and across the factory catalogue — same OEM/ODM terms, same quality control.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {relatedProducts.map((rp) => (
            <ProductCard
              title={rp.title}
              handle={rp.handle}
              price={rp.price}
              image={rp.images?.[0]?.src || '/placeholder.jpg'}
              imageAlt={rp.images?.[0]?.alt || rp.title}
            />
          ))}
        </div>
        <div class="text-center mt-10">
          <a
            href={catHandle ? `/collections/${catHandle}/` : '/collections/all/'}
            class="inline-block bg-navy text-white font-bold px-8 py-3 rounded-lg hover:bg-orange transition-colors"
          >
            View All {catTitle}
          </a>
        </div>
      </section>
    )}
  </article>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(gallery)}></script>
  <script is:inline>
    const galleryImages = JSON.parse(document.getElementById('gallery-data').textContent);
    let currentImage = 0;

    function renderMain() {
      const main = document.getElementById('main-product-image');
      main.src = galleryImages[currentImage].src;
      main.alt = galleryImages[currentImage].alt || main.alt;
    }
    function nextImage() {
      currentImage = (currentImage + 1) % galleryImages.length;
      renderMain();
    }
    function prevImage() {
      currentImage = (currentImage - 1 + galleryImages.length) % galleryImages.length;
      renderMain();
    }
    function goToImage(i) {
      currentImage = i;
      renderMain();
    }
  </script>
</BaseLayout>
