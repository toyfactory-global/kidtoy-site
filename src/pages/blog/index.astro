---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob('./*.md', { eager: true }) as Record<string, any>;
const posts = Object.entries(modules)
  .map(([path, mod]) => ({
    slug: path.replace('./', '').replace('.md', ''),
    title: mod.frontmatter?.title || '',
    description: mod.frontmatter?.description || '',
    date: mod.frontmatter?.date || '',
  }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));

const SITE = 'https://kidtoycn.com';
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Toy Sourcing & Import Buyer Guides"
  description="Practical guides for toy importers and wholesale buyers: HS codes, certifications, MOQ and landed cost, container loading, and how to verify a factory in Chenghai."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Buyer Guides</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy mb-4">Toy Sourcing &amp; Import Guides</h1>
    <p class="text-lg text-gray-500 leading-relaxed mb-12 max-w-2xl">
      Everything we explain to buyers before their first order — how toy duty is calculated, which safety
      standard applies in which market, how MOQ affects landed cost, and how to check a factory before you wire
      a deposit.
    </p>

    <div class="divide-y divide-gray-100 border-t border-gray-100">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="group block py-8 hover:bg-gray-50/60 transition-colors -mx-4 px-4 rounded-lg">
          <p class="text-xs text-gray-400 mb-2">{fmt(p.date)}</p>
          <h2 class="text-xl font-extrabold text-navy mb-2 group-hover:text-orange transition-colors leading-snug">
            {p.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed max-w-2xl">{p.description}</p>
          <span class="inline-block mt-3 text-sm font-bold text-orange">Read guide &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": `${SITE}/blog/#blog`,
    "url": `${SITE}/blog/`,
    "name": "Toy Sourcing & Import Buyer Guides",
    "publisher": { "@id": `${SITE}/#organization` },
    "blogPost": posts.map((p) => ({
      "@type": "BlogPosting",
      "headline": p.title,
      "url": `${SITE}/blog/${p.slug}/`,
      "datePublished": p.date
    }))
  })} />
</BaseLayout>
