---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="max-w-xl mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-extrabold text-navy mb-4">404</h1>
    <p class="text-gray-500 mb-8">Page not found. The product or page you're looking for may have moved.</p>
    <a href="/" class="inline-block bg-navy text-white px-8 py-3 rounded font-bold text-sm hover:bg-orange transition-colors">Back to Homepage</a>
  </section>
</BaseLayout>
