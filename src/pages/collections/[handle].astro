---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { GUIDE_MAP } from '../../data/guide-map';
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  const all = { id: 0, title: 'All Products', handle: 'all', body_html: '' };
  return [{ params: { handle: 'all' } }, ...productsData.collections.map(c => ({
    params: { handle: c.handle }
  }))];
}

const { handle } = Astro.params;
const collection = handle === 'all'
  ? { id: 0, title: 'All Products', handle: 'all', body_html: '' }
  : productsData.collections.find(c => c.handle === handle);

if (!collection) {
  return Astro.redirect('/404');
}

// Match products to this collection using REAL assignments
const catProducts = handle === 'all'
  ? productsData.products
  : productsData.products.filter(p => (p.collections || []).includes(handle));

const SITE = 'https://kidtoycn.com';
const canonical = `${SITE}/collections/${handle}/`;

// MOQ range is derived from the actual products in this collection, so the
// answer we give buyers (and AI engines) is always true.
const moqs = catProducts.map(p => p.moq).filter(n => typeof n === 'number' && n > 0);
const moqMin = moqs.length ? Math.min(...moqs) : null;
const moqMax = moqs.length ? Math.max(...moqs) : null;
const moqText = moqMin === null
  ? 'MOQ is quoted per item.'
  : moqMin === moqMax
    ? `The minimum order quantity is ${moqMin} pcs per item.`
    : `MOQ ranges from ${moqMin} to ${moqMax} pcs depending on the item.`;

const intro = (collection.body_html || '').trim();
const collectionGuides = GUIDE_MAP[handle] || [];

/* ---- Range-level facts ---------------------------------------------------
   These four pages carry a third of the site's impressions, so they need the
   numbers a buyer compares on (price band, MOQ band, carton size) rather than a
   bare image wall. Everything below is computed from the products actually
   assigned to the collection — nothing is typed in by hand, so it cannot drift
   when items are added.
*/
const specRow = (html, aliases) => {
  const all = String(html || '').match(/<table[\s\S]*?<\/table>/gi) || [];
  const table = (all.find((t) => /Item No\./i.test(t)) || all[0] || null);
  if (!table) return '';
  for (const tr of (table.match(/<tr[\s\S]*?<\/tr>/gi) || [])) {
    const cells = [...tr.matchAll(/<t[dh][^>]*>([\s\S]*?)<\/t[dh]>/gi)].map((m) =>
      m[1].replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim()
    );
    if (cells.length >= 2) {
      const label = cells[0].toLowerCase();
      if (aliases.some((a) => a.toLowerCase() === label) && cells[1] && !/^[-–—]+$/.test(cells[1])) {
        return cells[1];
      }
    }
  }
  return '';
};
const firstNumber = (s) => {
  const m = String(s || '').match(/\d+(?:\.\d+)?/);
  return m ? Number(m[0]) : null;
};

const rows = catProducts.map((p) => {
  const cbm = firstNumber(specRow(p.body_html, ['Carton Volume', 'Export Carton Volume', 'CBM']));
  const ctn = specRow(p.body_html, ['Export Carton Qty', 'Quantity Per Full Export Carton']);
  const size = specRow(p.body_html, ['Carton Dimension', 'Carton Size']);
  const unitsPerCarton = firstNumber(ctn);
  return {
    title: p.title,
    handle: p.handle,
    sku: p.variants?.[0]?.sku || '',
    moq: p.moq,
    price: p.price,
    ctn: ctn,
    size: size,
    cbm: cbm,
    unitsPerCarton: unitsPerCarton,
  };
});

const prices = rows.map((r) => r.price).filter((n) => typeof n === 'number' && n > 0);
const priceMin = prices.length ? Math.min(...prices) : null;
const priceMax = prices.length ? Math.max(...prices) : null;
const cbms = rows.map((r) => r.cbm).filter((n) => typeof n === 'number' && n > 0);
const cbmMin = cbms.length ? Math.min(...cbms) : null;
const cbmMax = cbms.length ? Math.max(...cbms) : null;
const cbmAvg = cbms.length ? cbms.reduce((a, b) => a + b, 0) / cbms.length : null;

// Cartons that fit a 40HQ at the practical usable volume, as a planning figure.
const usableCbm = 68;
const cartonsPer40 = cbmAvg ? Math.floor(usableCbm / cbmAvg) : null;

const priceText =
  priceMin === null
    ? ''
    : priceMin === priceMax
      ? `USD ${priceMin.toFixed(2)} per piece`
      : `USD ${priceMin.toFixed(2)} – ${priceMax.toFixed(2)} per piece`;

const collectionDesc = (() => {
  const bits = [`${catProducts.length} wholesale lines in the ${collection.title.toLowerCase()} range, from our Chenghai factory (est. 2001).`];
  if (moqMin !== null) bits.push(moqMin === moqMax ? `MOQ ${moqMin} pcs.` : `MOQ ${moqMin}–${moqMax} pcs.`);
  if (priceText) bits.push(`FOB ${priceMin === priceMax ? `USD ${priceMin.toFixed(2)}` : `USD ${priceMin.toFixed(2)}–${priceMax.toFixed(2)}`}.`);
  bits.push('OEM/ODM available.');
  return bits.join(' ');
})();

const faqs = [
  {
    q: `What is the minimum order quantity for ${collection.title.toLowerCase()}?`,
    a: `${moqText} Lower volumes can be discussed for mixed-carton orders — send us the item list and target quantity.`
  },
  {
    q: 'Can you customise packaging, branding or the product itself?',
    a: 'Yes. We offer both OEM (we manufacture to your specification) and ODM (you select from our existing moulds and we brand them). Custom colour boxes, printed cartons, private labels and instruction manuals are all available.'
  },
  {
    q: 'Which toy safety certifications do you provide?',
    a: 'Our factory works to CE, EN71 and ASTM requirements, with test reports issued by accredited third-party laboratories. Certificate copies are available on request for any specific item before you place an order.'
  },
  {
    q: 'How do I get a quotation?',
    a: 'Send the item numbers and the quantity you need through the inquiry form, WhatsApp or email. We reply with unit price, carton dimensions, CBM and estimated lead time.'
  },
  {
    q: 'Do you ship worldwide and can you quote freight?',
    a: 'Yes. We ship by sea, air and express courier. We can quote FOB, CIF or door-to-door delivery, and we will tell you the carton count and total CBM so you can compare freight options.'
  }
];

/* Two more answers built from this collection's own numbers, so a buyer can
   size a first order without waiting for a reply. Only added when the data
   exists — an empty range would be worse than no answer. */
if (priceText) {
  faqs.push({
    q: `What do ${collection.title.toLowerCase()} cost per piece?`,
    a: `Current FOB pricing across this range is ${priceText}, ex-works Chenghai. Price moves with order volume, printing and packaging specification, and it is quoted per item on your quantity.`
  });
}
if (cbmAvg && cartonsPer40) {
  faqs.push({
    q: 'How many cartons fit in one 40HQ container?',
    a: `Cartons in this range run from ${cbmMin.toFixed(3)} to ${cbmMax.toFixed(3)} CBM, averaging ${cbmAvg.toFixed(3)} CBM. At a practical usable volume of about ${usableCbm} CBM that is roughly ${cartonsPer40.toLocaleString('en-US')} cartons for a single item — mixed loads are usually lower, because mixed carton sizes waste space. We will give you an exact carton count and loading plan for your item list.`
  });
}
---

<BaseLayout title={collection.title} description={collectionDesc}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-400 mb-6">
      <a href="/" class="hover:text-orange">Home</a> / <span class="text-navy font-semibold">{collection.title}</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy mb-2">{collection.title}</h1>
    <p class="text-gray-400 mb-4">
      Factory direct wholesale &bull; {catProducts.length} lines &bull; {moqMin !== null ? (moqMin === moqMax ? `MOQ ${moqMin} pcs` : `MOQ ${moqMin}–${moqMax} pcs`) : 'MOQ quoted per item'} &bull; OEM/ODM supported
    </p>

    <!-- Editorial intro: these pages used to be a bare image wall -->
    {intro ? (
      <div class="prose prose-sm max-w-3xl text-gray-600 leading-relaxed mb-10" set:html={intro} />
    ) : (
      <p class="max-w-3xl text-gray-600 leading-relaxed mb-10">
        {catProducts.length} factory-direct {collection.title.toLowerCase()} available for wholesale and OEM/ODM orders.
        Every item is manufactured in our own Chenghai facility, so pricing, packaging and lead times come straight from
        the production line rather than a trading company margin. {moqText}
      </p>
    )}

    <!-- Range at a glance: the comparison a buyer would otherwise build in a
         spreadsheet. Every column is read from the product's own spec table. -->
    <section class="mt-12 mb-14">
      <h2 class="text-xl sm:text-2xl font-extrabold text-navy mb-2">The Range, Line by Line</h2>
      <p class="text-sm text-gray-500 mb-5 max-w-3xl">
        {catProducts.length} items in this collection. MOQ, FOB price and carton data are the current figures for each SKU — enquiry for volume breaks above the standard quantity.
      </p>
      <div class="overflow-x-auto rounded-xl border border-gray-100">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-navy text-white text-left">
              <th class="px-4 py-3 font-bold whitespace-nowrap">Item</th>
              <th class="px-4 py-3 font-bold whitespace-nowrap">Item No.</th>
              <th class="px-4 py-3 font-bold whitespace-nowrap">MOQ</th>
              <th class="px-4 py-3 font-bold whitespace-nowrap">FOB / pc</th>
              <th class="px-4 py-3 font-bold whitespace-nowrap">Units / ctn</th>
              <th class="px-4 py-3 font-bold whitespace-nowrap">Carton</th>
              <th class="px-4 py-3 font-bold whitespace-nowrap">CBM</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {rows.map((r) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <a href={`/products/${r.handle}/`} class="font-semibold text-navy hover:text-orange">{r.title}</a>
                </td>
                <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{r.sku || '—'}</td>
                <td class="px-4 py-3 font-semibold text-navy whitespace-nowrap">{r.moq} pcs</td>
                <td class="px-4 py-3 font-semibold text-navy whitespace-nowrap">{r.price > 0 ? `$${r.price.toFixed(2)}` : 'On request'}</td>
                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{r.ctn || '—'}</td>
                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{r.size || '—'}</td>
                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{r.cbm ? r.cbm.toFixed(3) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {cbmAvg && (
        <p class="text-xs text-gray-400 mt-3">
          Cartons in this range average {cbmAvg.toFixed(3)} CBM, so a 40HQ at roughly {usableCbm} CBM usable holds about {cartonsPer40} cartons of a single line. Mixed loads run lower — ask for a loading plan built on your item list.
        </p>
      )}
    </section>

    {collectionGuides.length > 0 && (
      <section class="mt-14 mb-4">
        <h2 class="text-xl sm:text-2xl font-extrabold text-navy mb-2">Before You Order: Guides for This Range</h2>
        <p class="text-sm text-gray-500 mb-5 max-w-3xl">
          What buyers ask us most often about this category — written from the factory side, with the numbers we actually quote.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {collectionGuides.map((g) => (
            <a href={`/blog/${g.slug}/`} class="group block border border-gray-100 rounded-xl p-5 hover:border-orange hover:shadow-sm transition-all">
              <p class="text-xs font-bold uppercase tracking-widest text-orange mb-2">Guide</p>
              <p class="text-sm font-bold text-navy group-hover:text-orange transition-colors leading-snug">{g.title}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {catProducts.map(product => (
        <ProductCard
          title={product.title}
          handle={product.handle}
          price={product.price}
          image={product.images?.[0]?.src || '/placeholder.jpg'}
          imageAlt={product.images?.[0]?.alt || product.title}
        />
      ))}
    </div>

    <!-- Buyer FAQ: extractable single-fact answers for AEO / AI search -->
    <section class="mt-20 pt-12 border-t border-gray-100">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy mb-8">Wholesale Buying Questions</h2>
      <div class="max-w-3xl divide-y divide-gray-100">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <h3 class="text-base font-bold text-navy">{f.q}</h3>
              <span class="text-orange text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CollectionPage + ItemList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "url": canonical,
      "name": collection.title,
      "description": `Factory-direct wholesale ${collection.title.toLowerCase()} from a Chenghai toy manufacturer established in 2001.`,
      "isPartOf": { "@id": `${SITE}/#website` },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": catProducts.length,
        "itemListElement": catProducts.map((p, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `${SITE}/products/${p.handle}/`,
          "name": p.title
        }))
      }
    })} />

    <!-- FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  </section>
</BaseLayout>
