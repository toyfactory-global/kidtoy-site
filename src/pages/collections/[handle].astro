---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  const all = { id: 0, title: 'All Products', handle: 'all', body_html: '' };
  return [{ params: { handle: 'all' } }, ...productsData.collections.map(c => ({
    params: { handle: c.handle }
  }))];
}

const { handle } = Astro.params;
const collection = handle === 'all'
  ? { id: 0, title: 'All Products', handle: 'all', body_html: '' }
  : productsData.collections.find(c => c.handle === handle);

if (!collection) {
  return Astro.redirect('/404');
}

// Match products to this collection using REAL assignments
const catProducts = handle === 'all'
  ? productsData.products
  : productsData.products.filter(p => p.collections.includes(handle));
---

<BaseLayout title={collection.title} description={`Browse our ${collection.title.toLowerCase()} collection - factory direct wholesale pricing, OEM/ODM available.`}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-400 mb-6">
      <a href="/" class="hover:text-orange">Home</a> / <span class="text-navy font-semibold">{collection.title}</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy mb-2">{collection.title}</h1>
    <p class="text-gray-400 mb-10">Factory direct wholesale &bull; MOQ from 50 pcs &bull; OEM/ODM supported</p>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {catProducts.map(product => (
        <ProductCard
          title={product.title}
          handle={product.handle}
          price={product.price}
          image={product.images?.[0]?.src || '/placeholder.jpg'}
          imageAlt={product.images?.[0]?.alt || product.title}
        />
      ))}
    </div>
  </section>
</BaseLayout>
