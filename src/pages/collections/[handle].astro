---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  const all = { id: 0, title: 'All Products', handle: 'all', body_html: '' };
  return [{ params: { handle: 'all' } }, ...productsData.collections.map(c => ({
    params: { handle: c.handle }
  }))];
}

const { handle } = Astro.params;
const collection = handle === 'all'
  ? { id: 0, title: 'All Products', handle: 'all', body_html: '' }
  : productsData.collections.find(c => c.handle === handle);

if (!collection) {
  return Astro.redirect('/404');
}

// Match products to this collection using REAL assignments
const catProducts = handle === 'all'
  ? productsData.products
  : productsData.products.filter(p => (p.collections || []).includes(handle));

const SITE = 'https://kidtoycn.com';
const canonical = `${SITE}/collections/${handle}/`;

// MOQ range is derived from the actual products in this collection, so the
// answer we give buyers (and AI engines) is always true.
const moqs = catProducts.map(p => p.moq).filter(n => typeof n === 'number' && n > 0);
const moqMin = moqs.length ? Math.min(...moqs) : null;
const moqMax = moqs.length ? Math.max(...moqs) : null;
const moqText = moqMin === null
  ? 'MOQ is quoted per item.'
  : moqMin === moqMax
    ? `The minimum order quantity is ${moqMin} pcs per item.`
    : `MOQ ranges from ${moqMin} to ${moqMax} pcs depending on the item.`;

const intro = (collection.body_html || '').trim();

const faqs = [
  {
    q: `What is the minimum order quantity for ${collection.title.toLowerCase()}?`,
    a: `${moqText} Lower volumes can be discussed for mixed-carton orders — send us the item list and target quantity.`
  },
  {
    q: 'Can you customise packaging, branding or the product itself?',
    a: 'Yes. We offer both OEM (we manufacture to your specification) and ODM (you select from our existing moulds and we brand them). Custom colour boxes, printed cartons, private labels and instruction manuals are all available.'
  },
  {
    q: 'Which toy safety certifications do you provide?',
    a: 'Our factory works to CE, EN71 and ASTM requirements, with test reports issued by accredited third-party laboratories. Certificate copies are available on request for any specific item before you place an order.'
  },
  {
    q: 'How do I get a quotation?',
    a: 'Send the item numbers and the quantity you need through the inquiry form, WhatsApp or email. We reply with unit price, carton dimensions, CBM and estimated lead time.'
  },
  {
    q: 'Do you ship worldwide and can you quote freight?',
    a: 'Yes. We ship by sea, air and express courier. We can quote FOB, CIF or door-to-door delivery, and we will tell you the carton count and total CBM so you can compare freight options.'
  }
];
---

<BaseLayout title={collection.title} description={`Browse our ${collection.title.toLowerCase()} collection - factory direct wholesale pricing, OEM/ODM available.`}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-400 mb-6">
      <a href="/" class="hover:text-orange">Home</a> / <span class="text-navy font-semibold">{collection.title}</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy mb-2">{collection.title}</h1>
    <p class="text-gray-400 mb-4">Factory direct wholesale &bull; MOQ from 50 pcs &bull; OEM/ODM supported</p>

    <!-- Editorial intro: these pages used to be a bare image wall -->
    {intro ? (
      <div class="prose prose-sm max-w-3xl text-gray-600 leading-relaxed mb-10" set:html={intro} />
    ) : (
      <p class="max-w-3xl text-gray-600 leading-relaxed mb-10">
        {catProducts.length} factory-direct {collection.title.toLowerCase()} available for wholesale and OEM/ODM orders.
        Every item is manufactured in our own Chenghai facility, so pricing, packaging and lead times come straight from
        the production line rather than a trading company margin. {moqText}
      </p>
    )}

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {catProducts.map(product => (
        <ProductCard
          title={product.title}
          handle={product.handle}
          price={product.price}
          image={product.images?.[0]?.src || '/placeholder.jpg'}
          imageAlt={product.images?.[0]?.alt || product.title}
        />
      ))}
    </div>

    <!-- Buyer FAQ: extractable single-fact answers for AEO / AI search -->
    <section class="mt-20 pt-12 border-t border-gray-100">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy mb-8">Wholesale Buying Questions</h2>
      <div class="max-w-3xl divide-y divide-gray-100">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <h3 class="text-base font-bold text-navy">{f.q}</h3>
              <span class="text-orange text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CollectionPage + ItemList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "url": canonical,
      "name": collection.title,
      "description": `Factory-direct wholesale ${collection.title.toLowerCase()} from a Chenghai toy manufacturer established in 2001.`,
      "isPartOf": { "@id": `${SITE}/#website` },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": catProducts.length,
        "itemListElement": catProducts.map((p, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `${SITE}/products/${p.handle}/`,
          "name": p.title
        }))
      }
    })} />

    <!-- FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  </section>
</BaseLayout>
