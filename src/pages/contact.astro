---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us" description="Contact Kidtoy Factory for wholesale toy inquiries, OEM/ODM requests, and bulk pricing.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy mb-4">Contact Us</h1>
    <p class="text-gray-500 mb-10">Get in touch for wholesale inquiries, OEM/ODM requests, or bulk pricing.</p>

    <div class="grid md:grid-cols-2 gap-10">
      <div class="space-y-6">
        <div>
          <h3 class="font-bold text-navy text-sm uppercase tracking-wide">WhatsApp</h3>
          <a href="https://wa.me/8615952917707" target="_blank" rel="noopener" class="text-orange font-bold text-lg">+86 15976917707</a>
        </div>
        <div>
          <h3 class="font-bold text-navy text-sm uppercase tracking-wide">Email</h3>
          <p class="text-gray-500">hntoys6@sinuotoys.com</p>
        </div>
        <div>
          <h3 class="font-bold text-navy text-sm uppercase tracking-wide">Address</h3>
          <p class="text-gray-500">Chenghai District, Shantou, Guangdong, China</p>
        </div>
      </div>
      <div>
        <div class="bg-gray-50 rounded-xl p-8 text-center">
          <p class="text-navy font-extrabold text-xl mb-2">Send Us a Message</p>
          <p class="text-gray-400 text-sm mb-6">We typically respond within 2 business hours</p>
          <a href="https://wa.me/8615952917707?text=Hello%20Kidtoy%20Factory%2C%20I%20am%20interested%20in%20your%20products" target="_blank" rel="noopener" class="inline-block bg-green-500 text-white px-8 py-4 rounded font-bold text-sm hover:bg-green-600 transition-colors w-full">
            Chat on WhatsApp
          </a>
          <p class="text-xs text-gray-400 mt-4">Or email us at hntoys6@sinuotoys.com</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
