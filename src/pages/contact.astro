---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us" description="Contact Kidtoy Factory for wholesale toy inquiries, OEM/ODM requests, and bulk pricing.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy mb-4">Contact Us</h1>
    <p class="text-gray-500 mb-10">Get in touch for wholesale inquiries, OEM/ODM requests, or bulk pricing.</p>

    <div class="grid md:grid-cols-2 gap-10">
      <div class="space-y-6">
        <div>
          <h3 class="font-bold text-navy text-sm uppercase tracking-wide">WhatsApp</h3>
          <a href="https://wa.me/8613715961913" target="_blank" rel="noopener" class="text-orange font-bold text-lg">+86 13715961913</a>
        </div>
        <div>
          <h3 class="font-bold text-navy text-sm uppercase tracking-wide">Email</h3>
          <p class="text-gray-500">hntoys6@sinuotoys.com</p>
        </div>
        <div>
          <h3 class="font-bold text-navy text-sm uppercase tracking-wide">Address</h3>
          <p class="text-gray-500">Chenghai District, Shantou, Guangdong, China</p>
        </div>
      </div>
      <div>
        <div class="bg-gray-50 rounded-xl p-8">
          <p class="text-navy font-extrabold text-xl mb-6 text-center">Send Us a Message</p>
          <p class="text-gray-400 text-sm mb-6 text-center">We typically respond within 2 business hours</p>
          <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
            <input type="hidden" name="access_key" value="a9f6af03-8274-436c-9dc6-046d466bce9c" />
            <input type="hidden" name="subject" value="New Inquiry from Kidtoycn.com" />
            <input type="hidden" name="from_name" value="Kidtoy Website Contact Form" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Your Name</label>
                <input type="text" name="name" required placeholder="Full Name" class="w-full px-4 py-3 bg-white border border-gray-200 focus:border-orange focus:outline-none rounded-lg font-semibold text-navy placeholder:text-gray-300" />
              </div>
              <div>
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Work Email</label>
                <input type="email" name="email" required placeholder="email@company.com" class="w-full px-4 py-3 bg-white border border-gray-200 focus:border-orange focus:outline-none rounded-lg font-semibold text-navy placeholder:text-gray-300" />
              </div>
            </div>
            <div>
              <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Subject</label>
              <input type="text" name="subject2" required placeholder="Bulk Order / OEM Customization" class="w-full px-4 py-3 bg-white border border-gray-200 focus:border-orange focus:outline-none rounded-lg font-semibold text-navy placeholder:text-gray-300" />
            </div>
            <div>
              <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Message</label>
              <textarea name="message" required rows="5" placeholder="Tell us about your sourcing needs..." class="w-full px-4 py-3 bg-white border border-gray-200 focus:border-orange focus:outline-none rounded-lg font-semibold text-navy placeholder:text-gray-300 resize-none"></textarea>
            </div>
            <button type="submit" class="w-full bg-orange hover:bg-navy text-white py-4 rounded-lg font-bold text-base transition-colors">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
