---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroInquiryForm from '../components/HeroInquiryForm.astro';
import productsData from '../../data/products.json';

const products = productsData.products;
const collections = productsData.collections;

const getCategoryProducts = (handle: string) => products.filter((p: any) => p.collections.includes(handle));

// Real numbers only: every stat on this page is derived from products.json at
// build time, so the homepage cannot claim an MOQ or a price the catalogue does
// not have. (It previously said "MOQ 50+" and "as low as 36 pieces" while the
// real floor was 54 — the kind of drift that costs trust on the first reply.)
const moqs = products.map((p: any) => p.moq).filter((n: any) => typeof n === 'number' && n > 0);
const moqMin = Math.min(...moqs);
const moqMax = Math.max(...moqs);
const prices = products.map((p: any) => p.price).filter((n: any) => typeof n === 'number' && n > 0);
const priceMin = Math.min(...prices);
const priceMax = Math.max(...prices);

const money = (n: number) => '$' + n.toFixed(2);

// Hero poster assets: the original V3.8 transparent PNGs. They are deliberately
// the two categories with the widest price spread (makeup and water guns), so
// the poster reads as a range rather than a single product.
const heroMakeup = 'https://sc02.alicdn.com/kf/Af8923c1f621547b6ab6869248b119717w.png';
const heroWaterGun = 'https://sc02.alicdn.com/kf/Aacb85bc4dfdb40438c391ee78e83a560B.png';

const faqs = [
  {
    q: 'What is your minimum order quantity?',
    a: `Per item it is between ${moqMin} and ${moqMax} pieces, depending on the mould and the packaging. ${moqMin} pieces is the floor, on a small number of water gun and makeup lines. A first order can be mixed across several items, so you do not have to commit to ${moqMax} pieces of one design to start.`,
  },
  {
    q: 'How much does a wholesale toy cost from your factory?',
    a: `Our current catalogue runs from ${money(priceMin)} to ${money(priceMax)} FOB per piece, across ${products.length} items. The FOB price is not the landed cost — freight, duty and brokerage add 15–35% depending on volume and destination. Use the landed cost calculator to see what a specific item costs delivered.`,
  },
  {
    q: 'Can you put our brand on the product and the packaging?',
    a: 'Yes. We manufacture to your specification (OEM) or brand an existing mould (ODM). In practice that means a colour change, a pad-printed logo, a printed colour box, a sleeve or a private label. Each of those has its own minimum quantity and its own artwork approval step, so the branding often sets a higher quantity than the toy itself.',
  },
  {
    q: 'Which certifications do you provide?',
    a: 'Testing scope varies by model and by market, so the honest answer is item-specific. Our factory holds the social and quality audits; product test reports sit at item level. Ask for a specific item number and the destination market and we will tell you what documentation exists for that item today, and whether more testing is needed.',
  },
  {
    q: 'How long does production and shipping take?',
    a: 'Production is typically 15–25 days for a standard order and longer for a custom box or a new colour. Sea freight adds 20–35 days depending on the lane, clearance and inland delivery 7–10 days, express 3–7 days. For a seasonal deadline, count backwards from the shelf date rather than forwards from the order.',
  },
  {
    q: 'Do you ship worldwide, and can you quote freight?',
    a: 'Yes. We quote FOB, CIF and door-to-door. We will give you the carton count and total CBM with every quote so you can put the same numbers to your own forwarder and compare — and we will tell you which container the order actually fills.',
  },
  {
    q: 'Can I get a sample before ordering?',
    a: 'Yes. A stock item ships in a few days; a customised sample takes longer because the colour or the artwork has to be produced. The sample fee is refundable against the first order once it reaches five cartons. The buyer pays the sample freight.',
  },
  {
    q: 'What happens if the goods are defective?',
    a: 'Pre-shipment inspection is where defects are caught and reworked — before the container leaves. That is why we push buyers to book an inspection rather than rely on a post-arrival claim: the return freight on a container usually exceeds the value of the claim, which is why this is B2B wholesale with no unconditional returns.',
  },
  {
    q: 'Are you a factory or a trading company?',
    a: 'A factory, in Chenghai, Guangdong, operating since 2001, with moulding, assembly and packing on site. The practical difference is that the carton data and the MOQ on this site come from production records rather than from a third party, and a change to the product goes through our own line.',
  },
  {
    q: 'How do I place an order?',
    a: 'Send the item numbers, the quantity and the destination. We quote, you approve a sample, we schedule production against the deposit, you book an inspection, we ship against the balance and the documents. The full sequence is written out on the factory page.',
  },
];
---

<BaseLayout
  title="Wholesale Toys Direct from a Chenghai Factory"
  description={`Toy manufacturer in Chenghai since 2001. ${products.length} wholesale lines across kids makeup, bubble toys, electric water guns and STEM — MOQ from ${moqMin} pcs, FOB ${money(priceMin)}–${money(priceMax)}, OEM/ODM.`}
>
  <!-- ================= HERO POSTER ================= -->
  <section class="relative overflow-hidden border-b border-gray-100" style="background: linear-gradient(90deg, #EDF4FF 0%, #FFFFFF 40%, #FFFFFF 60%, #F3F0FF 100%);">
    <style>
      .hero-glow { position: absolute; width: 520px; height: 520px; border-radius: 50%; filter: blur(110px); opacity: 0.4; pointer-events: none; }
      .hero-img { mix-blend-mode: multiply; filter: brightness(1.05) contrast(1.1); pointer-events: none; }
    </style>
    <div class="relative w-full flex items-center justify-center lg:justify-between gap-6 px-[6%] py-16 lg:py-20" style="min-height: 780px;">
      <!-- Left product: kids makeup -->
      <div class="relative w-[23%] min-w-[180px] items-center justify-center hidden lg:flex" style="min-height: 470px;">
        <div class="hero-glow" style="left: -60px; top: 10%; background: #FFE3E3;"></div>
        <img src={heroMakeup} alt="Wholesale kids makeup set in a carry case" class="hero-img relative z-[1] w-full h-auto" style="transform: scale(1.12);" />
      </div>

      <!-- Centre: the poster headline -->
      <div class="text-center flex-1 max-w-3xl mx-auto relative z-10">
        <span class="inline-block bg-orange text-white px-6 py-2.5 rounded-full text-[11px] font-extrabold tracking-[0.16em] mb-8">
          CHENGHAI FACTORY · SINCE 2001
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-[3.2rem] font-extrabold text-navy leading-[1.05] tracking-tight">
          WHOLESALE GIFT &amp; TOY<br />
          <span class="text-orange text-2xl sm:text-3xl lg:text-[2.5rem] tracking-tight">FACTORY DIRECT SUPPLY</span>
        </h1>
        <p class="text-base lg:text-lg text-gray-500 mt-7 max-w-xl mx-auto leading-relaxed">
          {products.length} wholesale toy lines for importers, distributors and marketplace sellers. MOQ from
          {moqMin} pieces, FOB {money(priceMin)} to {money(priceMax)} — with the carton data you need to cost the
          freight before you commit.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-9 justify-center">
          <a href="/collections/all/" class="bg-navy text-white px-9 py-4 rounded font-bold text-sm hover:bg-orange transition-colors">
            BROWSE THE CATALOGUE
          </a>
          <a href="#quote" class="border-2 border-navy text-navy px-9 py-4 rounded font-bold text-sm hover:bg-navy hover:text-white transition-colors">
            REQUEST A QUOTE
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-6 tracking-wide">
          {products.length} lines · MOQ {moqMin}–{moqMax} pcs · 25 years · 5,000 m² in Chenghai
        </p>
      </div>

      <!-- Right product: electric water gun -->
      <div class="relative w-[24%] min-w-[190px] items-center justify-center hidden lg:flex" style="min-height: 470px;">
        <div class="hero-glow" style="right: -60px; top: 12%; background: #CDE9FF;"></div>
        <img src={heroWaterGun} alt="Wholesale electric water gun blaster" class="hero-img relative z-[1] w-full h-auto" style="transform: scale(1.15);" />
      </div>
    </div>
  </section>

  <!-- ================= QUOTE BAND ================= -->
  <section id="quote" class="bg-white border-b border-gray-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid lg:grid-cols-[0.95fr_1.05fr] gap-10 items-start">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Request a quote</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy leading-tight mb-4">
          Send the item numbers. We send the numbers back.
        </h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          Item numbers, target quantity and destination port are enough. You get unit price, MOQ, carton dimensions,
          total CBM and a production window — straight from our own production records, within one business day.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div>
            <div class="text-2xl font-extrabold text-navy">{products.length}</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wider">Catalogue lines</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-navy">{moqMin}+</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wider">MOQ per item</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-navy">25 yrs</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wider">Manufacturing</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-navy">5,000 m²</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wider">Chenghai plant</div>
          </div>
        </div>
      </div>

      <div>
        <HeroInquiryForm />
      </div>
    </div>
  </section>

  <!-- ================= FACTORY ================= -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div class="grid grid-cols-2 gap-4 -skew-y-3">
        <div class="space-y-4">
          <div class="h-44 bg-gray-100 rounded-xl overflow-hidden skew-y-3"><img src="https://sc01.alicdn.com/kf/H428b51622ec946f4932ed35bc5920addu.png" alt="Chenghai toy factory building" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="h-44 bg-gray-100 rounded-xl overflow-hidden skew-y-3"><img src="https://sc01.alicdn.com/kf/H86381d3008dd4c6598369147d6676cd3V.png" alt="Toy production workshop" class="w-full h-full object-cover" loading="lazy" /></div>
        </div>
        <div class="space-y-4 mt-8">
          <div class="h-44 bg-gray-100 rounded-xl overflow-hidden skew-y-3"><img src="https://sc01.alicdn.com/kf/H6b5dd0979c984ccdb93d56d8b7799d670.png" alt="Assembly line" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="h-44 bg-gray-100 rounded-xl overflow-hidden skew-y-3"><img src="https://sc01.alicdn.com/kf/H713c066d3f76416b92eedacf7add641eM.png" alt="Quality control inspection" class="w-full h-full object-cover" loading="lazy" /></div>
        </div>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">The factory</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-6">
          Trusted manufacturing<br />since 2001
        </h2>
        <p class="text-gray-500 leading-relaxed mb-4">
          Located in <strong class="text-navy">Chenghai, Guangdong</strong> — the toy production cluster of eastern
          Guangdong. Our 5,000 m² facility runs moulding, electronics sub-assembly, packing and pre-shipment inspection
          under one roof, so the carton data on this site comes from our own export records rather than from a trading
          company's estimate.
        </p>
        <p class="text-gray-500 leading-relaxed mb-8">
          The factory holds the social and quality audits; product test reports sit at item level and vary by model and
          market. If you need a specific standard for a specific item, ask with the item number and we will tell you
          what exists today.
        </p>
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="bg-white p-5 border-l-4 border-orange shadow-sm">
            <strong class="block text-navy text-xl">25+ Years</strong>
            <span class="text-sm text-gray-400">Manufacturing &amp; export</span>
          </div>
          <div class="bg-white p-5 border-l-4 border-orange shadow-sm">
            <strong class="block text-navy text-xl">5,000 m²</strong>
            <span class="text-sm text-gray-400">Chenghai plant</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/factory/" class="bg-navy text-white px-6 py-3 rounded-lg font-bold text-sm hover:bg-orange transition-colors">Inside the factory</a>
          <a href="/certifications/" class="border-2 border-navy text-navy px-6 py-3 rounded-lg font-bold text-sm hover:bg-navy hover:text-white transition-colors">Certificates &amp; audits</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TRUST STRIP ================= -->
  <section class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-navy font-extrabold text-sm mb-1">FACTORY DIRECT</div>
          <div class="text-gray-400 text-xs">No trading company in between</div>
        </div>
        <div>
          <div class="text-navy font-extrabold text-sm mb-1">REAL CARTON DATA</div>
          <div class="text-gray-400 text-xs">CBM and weight on every item</div>
        </div>
        <div>
          <div class="text-navy font-extrabold text-sm mb-1">OEM / ODM</div>
          <div class="text-gray-400 text-xs">Colour, logo and packaging</div>
        </div>
        <div>
          <div class="text-navy font-extrabold text-sm mb-1">PRE-SHIPMENT QC</div>
          <div class="text-gray-400 text-xs">Inspected before it leaves</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= WHO THIS IS FOR ================= -->
  <section class="py-16 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[0.75fr_1.25fr] gap-12">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Who we work with</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-5">
          Who this factory is built for
        </h2>
        <p class="text-gray-600 leading-relaxed">
          Four categories, {products.length} items, MOQ from {moqMin} pieces. The line is set up for buyers who order
          more than once and want the carton data before they commit — a range, a season, or a container.
        </p>
        <p class="text-gray-600 leading-relaxed mt-4">
          We make toys and kids makeup sets, not everything else. If your order sits outside those lines we will say so
          on the first reply, before a sample or a deposit, rather than quote for something we cannot make well.
        </p>
        <a href="/industries/" class="inline-block mt-6 text-sm font-bold text-orange hover:text-navy transition-colors">See the eight buyer segments →</a>
      </div>

      <div>
        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
          {[
            { t: 'Importers & distributors', d: 'You resell in volume and need carton data you can put to a forwarder.' },
            { t: 'Gift, toy & pharmacy buyers', d: 'You are building a range across three or four price points, not buying one SKU.' },
            { t: 'Amazon & TikTok sellers', d: 'You need retail-ready packing, a barcode and a tracking label, not just a toy.' },
            { t: 'OEM & private label', d: 'You want your brand on the case, the box or the product itself.' },
            { t: 'First-time importers', d: 'You want the sample, deposit, inspection and shipping steps spelled out.' },
            { t: 'Seasonal & educational', d: 'You buy against a school year or a holiday window and plan backwards from it.' },
          ].map((f) => (
            <div class="flex gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5 text-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 10-1.4 1.4l2 2a1 1 0 001.4 0l4-3.9z" clip-rule="evenodd" />
              </svg>
              <div>
                <div class="font-bold text-navy text-sm leading-snug">{f.t}</div>
                <div class="text-sm text-gray-500 leading-relaxed mt-1">{f.d}</div>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-8 pt-6 border-t border-gray-100 text-sm text-gray-500 leading-relaxed">
          Not sure which one you are? Send the item list and we will tell you what the order needs —
          including the parts that will cost you money.
          <a href="#quote" class="font-bold text-orange hover:text-navy transition-colors whitespace-nowrap">Start here →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= CATALOGUE BY CATEGORY ================= -->
  {collections.filter((c: any) => c.handle !== 'frontpage').map((collection: any) => {
    const catProducts = getCategoryProducts(collection.handle);
    return (
      <section class="py-12 bg-gray-50/60 border-y border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
            <div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-navy">{collection.title}</h2>
              <p class="text-sm text-gray-500 mt-1">
                {catProducts.length} wholesale {catProducts.length === 1 ? 'line' : 'lines'} · OEM/ODM available
              </p>
            </div>
            <a href={`/collections/${collection.handle}/`} class="text-sm font-bold text-orange hover:text-navy transition-colors">
              View all {collection.title} →
            </a>
          </div>

          {collection.banner && (
            <a href={`/collections/${collection.handle}/`} class="block mb-6 overflow-hidden rounded-xl">
              <img src={collection.banner} alt={collection.title} class="w-full h-auto" loading="lazy" />
            </a>
          )}

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            {catProducts.slice(0, 8).map((product: any) => (
              <ProductCard
                title={product.title}
                handle={product.handle}
                price={product.price}
                image={product.images?.[0]?.src || '/placeholder.jpg'}
                imageAlt={product.images?.[0]?.alt || product.title}
              />
            ))}
          </div>

          {catProducts.length === 0 && (
            <div class="text-center bg-white border border-dashed border-gray-200 rounded-xl py-12">
              <p class="text-navy font-bold text-lg mb-2">New STEM line-up coming</p>
              <p class="text-gray-400 text-sm">Ask us for the current STEM catalogue and MOQ pricing.</p>
            </div>
          )}
        </div>
      </section>
    );
  })}

  <!-- ================= PRICE AND MOQ ================= -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 article-body">
      <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Costing</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-6">
        How much does a wholesale toy order cost, and what is the minimum?
      </h2>
      <p>
        Two numbers decide whether an order is worth placing: the MOQ, which sets your cash exposure, and the landed cost,
        which sets whether the retail price works. Neither is visible on a price list.
      </p>
      <p>
        Our MOQ runs from <strong>{moqMin} to {moqMax} pieces per design</strong>. The floor sits on a small number of water
        gun and makeup lines; the ceiling is on items where the mould or the packaging makes a short run uneconomic. A
        first order can be mixed across several items, which is how most buyers start — three designs at their individual
        MOQ rather than {moqMax} pieces of one.
      </p>
      <p>
        The FOB price in the catalogue is <strong>{money(priceMin)} to {money(priceMax)}</strong>. On top of it comes
        freight, insurance, duty and brokerage, and those do not scale down with the order. On a small shipment the fixed
        charges can add more than 40% to the goods value, which is why a cheap unit price on a half-empty container is
        worse than a slightly higher one on a full container.
      </p>

      <div class="not-prose grid sm:grid-cols-3 gap-4 my-8">
        <div class="border border-gray-200 rounded-xl p-5">
          <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">MOQ range</div>
          <div class="text-2xl font-extrabold text-navy">{moqMin}–{moqMax}</div>
          <div class="text-xs text-gray-500 mt-1">pcs per design</div>
        </div>
        <div class="border border-gray-200 rounded-xl p-5">
          <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">FOB range</div>
          <div class="text-2xl font-extrabold text-navy">{money(priceMin)}–{money(priceMax)}</div>
          <div class="text-xs text-gray-500 mt-1">per piece</div>
        </div>
        <div class="border border-gray-200 rounded-xl p-5">
          <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">Landed uplift</div>
          <div class="text-2xl font-extrabold text-navy">15–35%</div>
          <div class="text-xs text-gray-500 mt-1">typical, all-in</div>
        </div>
      </div>

      <p>
        Work it out before you ask for a quotation. The <a href="/tools/landed-cost-calculator/" class="text-orange font-semibold">landed
        cost calculator</a> takes your freight quote and your duty rate and gives you the true cost per piece plus the
        wholesale price you need to hold a margin. The <a href="/tools/wholesale-price-break-calculator/" class="text-orange font-semibold">order
        volume calculator</a> runs the same arithmetic on a real catalogue item, including the cartons and the container
        fill.
      </p>
    </div>
  </section>

  <!-- ================= MARKETS AND DOCUMENTS ================= -->
  <section class="py-16 bg-gray-50 border-y border-gray-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 article-body">
      <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Compliance</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-6">
        Which documents will your market ask for at the border?
      </h2>
      <p>
        The short answer is: it depends on the product, not on the supplier. A plastic role-play toy, a battery-operated
        bubble machine and a kids lip gloss are three different regulatory objects, even when they sit in the same carton.
      </p>
      <ul>
        <li><strong>EU:</strong> CE mark, EN 71 for the toy, EN 62115 for anything electric, plus REACH — and for a kids
          cosmetic, the Cosmetics Regulation instead of the toy directive.</li>
        <li><strong>US:</strong> ASTM F963 testing, CPSIA lead and phthalate limits, a Children's Product Certificate and a
          tracking label on the product and the packaging.</li>
        <li><strong>UK, Canada, Australia, Gulf, Brazil, Japan:</strong> each has its own mark or registration and its own
          labelling language requirement.</li>
      </ul>
      <p>
        The <a href="/tools/toy-certification-matrix/" class="text-orange font-semibold">certification matrix</a> sets the
        eight main markets side by side, by product type, and states what each document does not prove. Read that before
        you accept a supplier's folder of certificates as an answer.
      </p>
      <p>
        Our position is narrow and deliberate: we document what a specific item has actually been tested for, and we do not
        claim a standard on a product that has not been tested against it. Testing scope varies by model and market — ask
        with an item number and a destination.
      </p>
    </div>
  </section>

  <!-- ================= LOGISTICS ================= -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 article-body">
      <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Shipping</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-6">
        What does it take to ship a toy order?
      </h2>
      <p>
        Toys are usually volume-bound rather than weight-bound: a carton of bubble machines fills space long before it
        approaches a container's payload. That means the number that matters is the carton dimension, and the number that
        decides your freight per piece is how much of the container the order fills.
      </p>
      <p>
        Every product page carries pieces per carton, carton dimensions, CBM and gross weight, taken from our export
        records. With those four numbers you can price the freight yourself before you commit — or put them straight into
        the <a href="/tools/container-loading-calculator/" class="text-orange font-semibold">container loading
        calculator</a> and see whether the order is a 20GP, a 40HQ, or a mixed load that needs rebalancing.
      </p>
      <p>
        Two things worth planning before the order rather than after. <strong>Battery toys</strong> need a UN 38.3 report
        on the cell before an airline will carry them, which rules out a last-minute air shipment. And
        <strong>liquid-filled products</strong> change the shipping class, so a bubble toy that ships comfortably by sea may
        be restricted by air.
      </p>
    </div>
  </section>

  <!-- ================= OEM / ODM ================= -->
  <section class="py-16 bg-gray-50 border-y border-gray-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 article-body">
      <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">Branding</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-6">
        Can you brand the product and the packaging?
      </h2>
      <p>
        Yes, at four levels of commitment, and the cost is mostly in the minimum quantity rather than in the unit price:
      </p>
      <ul>
        <li><strong>Insert card or sticker</strong> in a stock box — lowest minimum, fastest, and it still reads as branded
          when the box is opened.</li>
        <li><strong>Printed sleeve</strong> over the stock box — looks like a custom box without a custom-box print run.</li>
        <li><strong>Fully printed colour box</strong> — the cleanest result, the highest minimum, because it is a separate
          print and die-cut run.</li>
        <li><strong>OEM</strong> — a colour change, a new mould or a modified product. This is a tooling and development
          project with its own timeline, not a packaging option.</li>
      </ul>
      <p>
        ODM is usually the right starting point: you choose from moulds we already run, we brand them, and you reach market
        in weeks instead of months. Move to OEM once a product has proven itself — starting with OEM on an unproven design
        is the expensive way to learn.
      </p>
    </div>
  </section>

