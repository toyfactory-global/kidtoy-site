---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOMeta from '../components/SEOMeta.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const fullTitle = title ? `${title} | Kidtoy Factory` : 'Experienced Toy Manufacturer | B2B Wholesale Supply Chenghai';
const fullDesc = description || 'Direct source for high-quality toys and children\'s makeup from Chenghai. Professional OEM/ODM factory with competitive wholesale pricing.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <SEOMeta title={fullTitle} description={fullDesc} image={ogImage || 'https://sc01.alicdn.com/kf/H5b709afcbe1b418ebb9114ba3f7d528ea.png'} />

    <!-- JSON-LD Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Corporation",
      "@id": "https://kidtoycn.com/#organization",
      "name": "Kidtoy Factory",
      "url": "https://kidtoycn.com",
      "description": "Toy manufacturer and direct B2B wholesaler based in Chenghai, Guangdong, China. Established 2001. OEM/ODM production for toy retailers, distributors and brand owners worldwide.",
      "foundingDate": "2001",
      "address": { "@type": "PostalAddress", "addressLocality": "Chenghai", "addressRegion": "Guangdong", "addressCountry": "CN" },
      "email": "hntoys6@sinuotoys.com",
      "contactPoint": { "@type": "ContactPoint", "telephone": "+86-13715961913", "email": "hntoys6@sinuotoys.com", "contactType": "sales", "availableLanguage": ["English", "Chinese"] }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://kidtoycn.com/#website",
      "url": "https://kidtoycn.com",
      "name": "Kidtoy Factory | B2B Wholesale Toy Supply",
      "publisher": { "@id": "https://kidtoycn.com/#organization" },
      "potentialAction": { "@type": "SearchAction", "target": "https://kidtoycn.com/search?q={search_term_string}", "query-input": "required name=search_term_string" }
    })} />

    <!-- Google Analytics 4. Deliberately a plain top-level function rather than
         define:vars, which Astro wraps in an IIFE and would leave window.gtag
         undefined for the listeners below. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TDNP3XVNMP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-TDNP3XVNMP');

      // One delegated listener covers every WhatsApp link on the site.
      document.addEventListener('click', function (e) {
        var el = e.target;
        while (el && el !== document.body) {
          if (el.tagName === 'A' && el.href &&
              (el.href.indexOf('wa.me') !== -1 || el.href.indexOf('api.whatsapp.com') !== -1)) {
            gtag('event', 'contact_whatsapp', {
              link_url: el.href,
              page_path: window.location.pathname
            });
            return;
          }
          el = el.parentNode;
        }
      });

      // The contact page posts straight to Web3Forms with no JS in between, so the
      // submit event is the only signal available. The product form is excluded here
      // because it reports generate_lead only after Web3Forms confirms receipt.
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if (!f || f.id === 'inquiry-form') return;
        gtag('event', 'form_submit', {
          form_destination: f.action,
          page_path: window.location.pathname
        });
      });
    </script>

    <script is:inline>
      document.documentElement.classList.add('loaded');
    </script>
  </head>
  <body class="bg-white text-gray-800 font-sans">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- LEAD LOG. A fire-and-forget copy of every inquiry, sent alongside the
         normal submission. The form still posts straight to Web3Forms, so a
         blocked or lost beacon costs us one row in the log, never the inquiry. -->
    <script is:inline>
      (function () {
        var LOG = 'https://kidstoyglobal.com/api/inquiry-log';
        function send(form) {
          var action = form.getAttribute('action') || '';
          if (action.indexOf('web3forms.com') === -1) return;
          try {
            var body = new URLSearchParams();
            new FormData(form).forEach(function (value, key) {
              var v = typeof value === 'string' ? value : '';
              body.append(key, v.length > 2000 ? v.slice(0, 2000) : v);
            });
            if (!body.get('page_path')) body.append('page_path', location.pathname);
            if (navigator.sendBeacon) navigator.sendBeacon(LOG, body);
          } catch (e) {
            /* logging is best-effort only */
          }
        }
        document.addEventListener(
          'submit',
          function (e) {
            var f = e.target;
            if (f && f.tagName === 'FORM') send(f);
          },
          true
        );
      })();
    </script>

    <!-- OPEN IN A NEW TAB — desktop only. The buyer wanted every link to open a
         fresh tab on a computer so the catalogue, the guide and the page they
         came from stay open; on a phone those tabs are invisible and the back
         button becomes unreliable, so below 1024px links navigate normally.
         One delegated handler rather than target="_blank" on every anchor means
         new pages inherit the behaviour, and ctrl/cmd/shift-click still means
         what the browser says it means. In-page anchors (#quote), mailto:, tel:
         and downloads are left alone. -->
    <script is:inline>
      (function () {
        var isPhone = window.matchMedia('(max-width: 1023px)');

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest ? e.target.closest('a') : null;
          if (!a) return;
          var href = a.getAttribute('href');
          if (!href || href.charAt(0) === '#') return;
          if (/^(mailto:|tel:|javascript:)/i.test(href)) return;
          if (a.hasAttribute('download')) return;

          var url;
          try { url = new URL(href, location.href); } catch (err) { return; }
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;

          if (isPhone.matches) {
            // On a phone a new tab is invisible and the back button stops working.
            // Any internal link that was hardcoded target="_blank" is pulled back
            // into the same tab so the whole site behaves consistently.
            if (a.target === '_blank' && url.origin === location.origin) {
              e.preventDefault();
              location.href = url.href;
            }
            return;
          }

          if (a.target === '_blank' || a.target === '_new') return;
          // Same page, hash only: let the browser scroll instead of opening a copy.
          if (url.pathname === location.pathname && url.hash && !url.search) return;
          e.preventDefault();
          window.open(url.href, '_blank', 'noopener');
        });
      })();
    </script>
  </body>
</html>
