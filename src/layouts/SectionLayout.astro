---
/**
 * Section layout for the reference and landing pages added in the LuxoPack
 * comparison pass: /tools/, /industries/, /case-studies/, /factory/,
 * /certifications/.
 *
 * Why one shared layout: every one of these pages needs the same four things to
 * be usable by Google and quotable by AI engines — a breadcrumb, a single H1,
 * a crawlable question block, and BreadcrumbList + WebPage + FAQPage JSON-LD
 * that match visible text exactly. Building that per page would drift.
 */
import BaseLayout from './BaseLayout.astro';

export interface Props {
  kicker: string;
  title: string;
  description: string;
  h1?: string;
  lede: string;
  /** Parent hub: { href, label } — used for the breadcrumb and the JSON-LD trail. */
  parent?: { href: string; label: string };
  faqs?: { q: string; a: string }[];
  related?: { href: string; label: string; note?: string }[];
  updated?: string;
}

const {
  kicker,
  title,
  description,
  h1,
  lede,
  parent,
  faqs = [],
  related = [],
  updated = '2026-11-23',
} = Astro.props;

const SITE = 'https://kidtoycn.com';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const heading = h1 || title;

const trail = [
  { name: 'Home', url: `${SITE}/` },
  ...(parent ? [{ name: parent.label, url: `${SITE}${parent.href}` }] : []),
  { name: heading, url: canonical },
];
---

<BaseLayout title={title} description={description}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-sm text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-orange">Home</a>
      {parent && (
        <>
          {' / '}
          <a href={parent.href} class="hover:text-orange">{parent.label}</a>
        </>
      )}
      {' / '}
      <span class="text-navy font-semibold">{heading}</span>
    </nav>

    <header class="max-w-3xl mb-12">
      <p class="text-xs font-bold uppercase tracking-widest text-orange mb-3">{kicker}</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy leading-tight mb-4">{heading}</h1>
      <p class="text-lg text-gray-500 leading-relaxed">{lede}</p>
      <p class="text-xs text-gray-400 mt-4">Reviewed {updated} · Kidtoy Factory, Chenghai, Guangdong</p>
    </header>

    <div class="article-body max-w-3xl">
      <slot />
    </div>

    {faqs.length > 0 && (
      <section class="max-w-3xl mt-16 pt-10 border-t border-gray-100">
        <h2 class="text-2xl font-extrabold text-navy mb-6">Questions buyers ask about this</h2>
        <div class="divide-y divide-gray-100">
          {faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <h3 class="text-base font-bold text-navy">{f.q}</h3>
                <span class="text-orange text-xl leading-none group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16 pt-10 border-t border-gray-100">
        <h2 class="text-xl font-extrabold text-navy mb-5">Keep reading</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {related.map((r) => (
            <a href={r.href} class="block border border-gray-200 rounded-xl p-5 hover:border-orange transition-colors group">
              <span class="block font-bold text-navy group-hover:text-orange transition-colors">{r.label}</span>
              {r.note && <span class="block text-sm text-gray-500 mt-1 leading-relaxed">{r.note}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    <aside class="max-w-3xl mt-14 bg-navy rounded-2xl p-8 text-white">
      <h2 class="text-xl font-extrabold mb-2 text-white">Want this priced against your own order?</h2>
      <p class="text-sm text-gray-300 leading-relaxed mb-5">
        Send the item numbers, target quantity and destination port. We reply with unit price, carton count,
        total CBM and freight options — straight from our Chenghai production line.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact/" class="inline-block bg-orange text-white font-bold px-7 py-3 rounded-lg hover:bg-white hover:text-navy transition-colors">Request a quote</a>
        <a href="https://wa.me/8613715961913?text=Hello%20Kidtoy%20Factory%2C%20I%20have%20a%20question%20about%20an%20upcoming%20order" target="_blank" rel="noopener noreferrer" class="inline-block border border-white/40 font-bold px-7 py-3 rounded-lg hover:bg-white hover:text-navy transition-colors">WhatsApp</a>
      </div>
    </aside>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: heading,
      description,
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
      dateModified: updated,
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: trail.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.name,
        item: t.url,
      })),
    })} />

    {faqs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    )}
  </article>
</BaseLayout>
