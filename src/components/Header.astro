---
import { getCollection } from 'astro:content';
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href="/" class="text-navy font-extrabold text-xl tracking-tight">
      KIDTOY<span class="text-orange">FACTORY</span>
    </a>
    <div class="hidden md:flex items-center gap-6">
      <a href="/collections/water-guns" class="text-sm font-semibold text-navy hover:text-orange transition-colors uppercase tracking-wide">Water Guns</a>
      <a href="/collections/kids-makeup" class="text-sm font-semibold text-navy hover:text-orange transition-colors uppercase tracking-wide">Makeup</a>
      <a href="/collections/bubble-toys" class="text-sm font-semibold text-navy hover:text-orange transition-colors uppercase tracking-wide">Bubble Toys</a>
      <a href="/collections/stem-toys" class="text-sm font-semibold text-navy hover:text-orange transition-colors uppercase tracking-wide">STEM Toys</a>
      <a href="/collections/all" class="text-sm font-semibold text-navy hover:text-orange transition-colors uppercase tracking-wide">All Products</a>
      <a href="/contact" class="ml-4 bg-navy text-white px-5 py-2 rounded text-sm font-bold hover:bg-orange transition-colors">CONTACT US</a>
    </div>
    <button class="md:hidden text-navy" id="menu-toggle" aria-label="Toggle menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pb-4">
    <a href="/collections/water-guns" class="block py-3 text-sm font-semibold text-navy border-b border-gray-50">Water Guns</a>
    <a href="/collections/kids-makeup" class="block py-3 text-sm font-semibold text-navy border-b border-gray-50">Makeup</a>
    <a href="/collections/bubble-toys" class="block py-3 text-sm font-semibold text-navy border-b border-gray-50">Bubble Toys</a>
    <a href="/collections/stem-toys" class="block py-3 text-sm font-semibold text-navy border-b border-gray-50">STEM Toys</a>
    <a href="/collections/all" class="block py-3 text-sm font-semibold text-navy border-b border-gray-50">All Products</a>
    <a href="/contact" class="block py-3 text-sm font-bold text-orange">Contact Us</a>
  </div>
</header>

<script is:inline>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
